@model CourseEnrollmentApp.Models.EnrollmentViewModel

@{
    ViewData["Title"] = "Course Enrollment";
}

<h2>State Management Demonstration</h2>

<!-- Information Section displaying stored values -->
<div class="alert alert-info">
    <p><strong>Query String Received Course ID:</strong> @ViewBag.CourseIdFromQueryString</p>
    <p><strong>Stored Cookie (Student Name):</strong> @(ViewBag.SavedStudentName ?? "No Cookie Saved")</p>
    <p><strong>Stored Session (Selected Course):</strong> @(ViewBag.SavedCourseFromSession ?? "No Session Saved")</p>
</div>

<!-- Enrollment Form submitting to SubmitEnrollment action -->
<form asp-action="SubmitEnrollment" method="post" class="mt-3">

    <!-- HIDDEN FIELD: Silently submits CourseId with form -->
    <input type="hidden" asp-for="CourseId" />

    <div class="mb-3">
        <label class="form-label">Student Name:</label>
        <!-- Pre-populates from model if cookie exists -->
        <input asp-for="StudentName" class="form-control" placeholder="Enter your name" required />
    </div>

    <button type="submit" class="btn btn-primary">Submit Enrollment</button>
</form>