@model IEnumerable<CourseEnrollmentApp.Models.Course>

@{
    ViewData["Title"] = "Course List";
}

<div class="container mt-4">
    <h2>Course Enrollment System</h2>

    <!-- Navigation Bar for Practical Exam Demo -->
    <div class="mb-4 btn-group" role="group">
        <a href="/Course" class="btn btn-primary active">1. Course List (IMemoryCache)</a>
        <a href="/Course/Details" class="btn btn-secondary">2. Course Details (Extension Method)</a>
        <a href="/Course/Users" class="btn btn-info text-white">3. User API (Async Request)</a>
        <a href="/Course/Enroll?courseId=101" class="btn btn-success">4. State Management Form</a>
    </div>

    <div class="alert alert-info">
        <p><strong>Cache Status:</strong> @ViewBag.CacheStatus</p>
        <p><strong>Fetched At:</strong> @ViewBag.FetchTime (Expires in 5 minutes)</p>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Course ID</th>
                <th>Course Name</th>
                <th>Duration</th>
                <th>Fees</th>
                <th>Discount</th>
                <th>Final Fees</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseId</td>
                    <td>@course.CourseName</td>
                    <td>@course.Duration</td>
                    <td>₹@course.Fees.ToString("N2")</td>
                    <td>@course.DiscountPercentage%</td>
                    <td>₹@course.CalculateFinalFees().ToString("N2")</td>
                    <td>
                        <a href="/Course/Enroll?courseId=@course.CourseId" class="btn btn-sm btn-success">Enroll</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>